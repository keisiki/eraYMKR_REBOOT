@RBT_CHARA_PATCHER(ARG)
#DIM DYNAMIC 캐릭터번호
캐릭터번호 = CHARANUM - 1
CFLAG:캐릭터번호:메뉴 = FS_기본세팅:0
CFLAG:캐릭터번호:식사량 = FS_기본세팅:1
RS_ROOM:(RBT_RS_SEARCH_EMPTY()):R방주인:0 = 캐릭터번호
SIF RBT_RS_CLEANINIG_SLAVE(RBT_RS_CHARA_TO_ROOMNUM(캐릭터번호)) == -1
    CALL RBT_RS_CLEANINIG_SLAVE_CHANGE(RBT_RS_CHARA_TO_ROOMNUM(캐릭터번호),캐릭터번호)

@RBT_PATCHER()
IF !GETBIT(FLAG:리부트패치,1)
    SETBIT FLAG:리부트패치,1
    CALL RBT_RS_GAMEINIT(CALC_SLAVE_CAPACITY())
    FOR LOCAL:1, 0, CHARANUM
        RS_청소:(LOCAL:1):0 = -1
        IF RBT_RS_CHARA_TO_ROOMNUM(LOCAL:1) == -1
            RS_ROOM:LOCAL:R방주인:0 = LOCAL:1
            PRINTFORML {LOCAL}번 방에 %CALLNAME:(LOCAL:1)% 배정
            CALL RBT_RS_CLEANINIG_SLAVE_CHANGE(LOCAL,LOCAL:1)
            LOCAL++
        ENDIF
    NEXT
    ITEM:연료 = 50
    희망온도 = 20
ENDIF
IF !GETBIT(FLAG:리부트패치,2)
    SETBIT FLAG:리부트패치,2
    CFLAG:MASTER:조리자 = 1
    FS_기본세팅:0 = 1
    FS_기본세팅:1 = 2
    FOR LOCAL,0,CHARANUM
        IF !CFLAG:LOCAL:식사량
            CFLAG:LOCAL:메뉴 = FS_기본세팅:0
            CFLAG:LOCAL:식사량 = FS_기본세팅:1
        ENDIF
    NEXT
ENDIF
IF !GETBIT(FLAG:리부트패치,3)
    SETBIT FLAG:리부트패치,3
    ITEM:하급식재 = 40
ENDIF