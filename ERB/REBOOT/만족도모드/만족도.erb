;rbt SaTisfaction System

;만족도란: 노예에 대한 대우가 높아짐에 따라 함락도가 빠르게 상승하는 것
;낮은 경우에 약간의 패널티(반감 상승도 증가)가 있을수도 있지만 일반적으로 노예가 그런거에 불만을 가지진 않을듯
;각 캐릭터는 요구치를 제시하고, 만족도가 요구치보다 매우 낮으면 패널티, 요구치와 같거나 더 크면 호감증가량 상승 등을 제공
;사실 따지고보면 가구의 호감/순종증가랑 겹치지만 그쪽은 수치를 낮게 잡았으니...
;요컨데 "이만큼은 해 줘!"의 요구치보다는 "이만큼이나 해주다니!" 같은 +적 요소
;당연히 제공되는 호의에 적응하는 시스템도 도입하고 싶은데, 아마 만족도 변수랑 적응된 만족도 변수를 두고 매우 천천히 적응된 만족도 변수가 만족도변수를 따라가는 식으로 하는 게 적당
;요구치보다 아주 낮으면 패널티라 했지만 이 패널티 선도 적응에 따라 올라가거나 내려간다.
;스트레스 조정도 같이 해주면 좋다

;=========================================================
;만족도 요구량을 반환하는 함수
;=========================================================
@RBT_STS_NEED(캐릭터)
#FUNCTION
#DIM CONST 기본요구도 = 25
#DIM DYNAMIC 캐릭터
#DIM DYNAMIC 요구치

요구치 = CFLAG:캐릭터:적응만족도
요구치 += 1 ;적응완료후 만족 보너스를 제거하기 위해 +1
SIF TALENT:캐릭터:반항적
    요구치 += 10
SIF TALENT:캐릭터:건방짐
    요구치 += 10
SIF TALENT:캐릭터:저항
    요구치 += 20
SIF TALENT:캐릭터:프라이드가높음
    요구치 += 20
SIF TALENT:캐릭터:유아
    요구치 += 15
SIF TALENT:캐릭터:유치
    요구치 += 15

SIF TALENT:캐릭터:연모
    요구치 += 20
SIF TALENT:캐릭터:친애
    요구치 += 20
SIF TALENT:캐릭터:상애
    요구치 += 10

SIF TALENT:캐릭터:복종
    요구치 -= 10
SIF TALENT:캐릭터:예속
    요구치 -= 20
SIF TALENT:캐릭터:비관적
    요구치 -= 10
SIF TALENT:캐릭터:프라이드가낮음
    요구치 -= 10
SIF TALENT:캐릭터:자제심
    요구치 -= 10

SIF 요구치 < 기본요구도
    요구치 = 기본요구도
SIF 캐릭터 == MASTER
    요구치 = 10
RETURNF 요구치


;=========================================================
;적응만족도를 갱신하는 함수
;=========================================================
@RBT_STS_ADAPTIED(캐릭터)
#DIM CONST 만족도변화계수 = 20 ;% 단위, 20이라면 만족도와 적응만족도의 차이의 20%만큼이 적응만족도에 더해짐
#DIM DYNAMIC 캐릭터
#DIM DYNAMIC 요구치
요구치 = 타겟대우(캐릭터)
CFLAG:캐릭터:적응만족도 = CFLAG:캐릭터:적응만족도 + ((CFLAG:캐릭터:적응만족도 - 요구치) * 만족도변화계수 / 100)


;=========================================================
;만족도 달성정도를 계산하는 함수
;=========================================================
@RBT_STS_LEVEL(캐릭터)
#FUNCTION
#DIM DYNAMIC 캐릭터
#DIM DYNAMIC 요구치
요구치 = RBT_STS_NEED(캐릭터)
요구치 = 타겟대우(캐릭터) * 100 / 요구치
SELECTCASE 요구치
    CASE IS < 25 ;패널티 2단계
        RETURNF -2
    CASE IS < 50 ;패널티 1단계
        RETURNF -1
    CASE IS < 100 ;패널티 없음
        RETURNF 0
    CASE IS < 150 ;혜택 1단계
        RETURNF 1
    CASE IS < 200 ;혜택 2단계
        RETURNF 2
    CASEELSE ;혜택 3단계
        RETURNF 3
ENDSELECT

;=========================================================
;만족도 달성치에 따른 효과를 적용하는 함수
;=========================================================
@RBT_STS_APPLY(캐릭터)
#DIM DYNAMIC 캐릭터
#DIM DYNAMIC 달성정도
달성정도 = RBT_STS_LEVEL(캐릭터)
호감도증가배율:캐릭터:2 = 0
순종증가배율:캐릭터:2 = 0
굴복증가배율:캐릭터:2 = 0
부정증가배율:캐릭터:2 = 0
회복배율:캐릭터:2 = 0
스트레스증가:캐릭터:2 = 0
SELECTCASE 달성정도
    CASE -2
        호감도증가배율:캐릭터:2 = -1
        순종증가배율:캐릭터:2 = -1
        굴복증가배율:캐릭터:2 = -1
        부정증가배율:캐릭터:2 = 1
        회복배율:캐릭터:2 = -1
        스트레스증가:캐릭터:2 = 50 
    CASE -1
        호감도증가배율:캐릭터:2 = 0
        순종증가배율:캐릭터:2 = 0
        굴복증가배율:캐릭터:2 = 0
        부정증가배율:캐릭터:2 = 0
        회복배율:캐릭터:2 = 0
        스트레스증가:캐릭터:2 = 10
    CASE 1
        호감도증가배율:캐릭터:2 = 1
        순종증가배율:캐릭터:2 = 1
        굴복증가배율:캐릭터:2 = 1
        부정증가배율:캐릭터:2 = 1
        회복배율:캐릭터:2 = 5
        스트레스증가:캐릭터:2 = -5 
    CASE 2
        호감도증가배율:캐릭터:2 = 3
        순종증가배율:캐릭터:2 = 3
        굴복증가배율:캐릭터:2 = 3
        부정증가배율:캐릭터:2 = 3
        회복배율:캐릭터:2 = 3
        스트레스증가:캐릭터:2 = -10
    CASE 3
        호감도증가배율:캐릭터:2 = 5 
        순종증가배율:캐릭터:2 = 5
        굴복증가배율:캐릭터:2 = 5
        부정증가배율:캐릭터:2 = 5
        회복배율:캐릭터:2 = 5
        스트레스증가:캐릭터:2 = -20 
ENDSELECT

