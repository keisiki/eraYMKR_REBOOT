@대상_제외됨(ARG)
#FUNCTION

IF TALENT:ARG:사망
    RETURNF 1
ENDIF

RETURNF 0



@대상_사망함(ARG)
TALENT:ARG:사망 = 1

IF TARGET < 0 || TARGET == ARG
    TARGET = -1
ELSE
    TARGET = (TARGET > ARG) ? (TARGET - 1) # TARGET
ENDIF
IF ASSI < 0 || ASSI == ARG
    ASSI = -1
ELSE
    ASSI = (ASSI > ARG) ? (ASSI - 1) # ASSI
ENDIF

DELCHARA ARG

FLAG:구상유 = -1
IF TARGET >= 0
    RESULT = -1
    TRYCALLFORM TRY_{NO}
    FLAG:구상유 = RESULT
ENDIF


