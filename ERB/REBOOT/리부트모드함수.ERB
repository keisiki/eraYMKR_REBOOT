;
; 사망이나 기타 사유로 인한 미등장을 처리하기 위함, 하드코딩때에 비해 기능 추가하기 용이
;
@대상_제외됨(ARG)
#FUNCTION

IF TALENT:ARG:사망
    RETURNF 1
ENDIF

RETURNF 0



@대상_사망함(ARG)
TALENT:ARG:사망 = 1

IF TARGET < 0 || TARGET == ARG
    TARGET = -1
ELSE
    TARGET = (TARGET > ARG) ? (TARGET - 1) # TARGET
ENDIF
IF ASSI < 0 || ASSI == ARG
    ASSI = -1
ELSE
    ASSI = (ASSI > ARG) ? (ASSI - 1) # ASSI
ENDIF

DELCHARA ARG

FLAG:구상유 = -1
IF TARGET >= 0
    RESULT = -1
    TRYCALLFORM TRY_{NO}
    FLAG:구상유 = RESULT
ENDIF


@RBT_PATCHER()
IF !GETBIT(FLAG:리부트패치,1)
    SETBIT FLAG:리부트패치,1
    CALL RBT_RS_GAMEINIT(CALC_SLAVE_CAPACITY())
    FOR LOCAL:1, 0, CHARANUM
        IF RBT_RS_CHARA_TO_ROOMNUM(LOCAL:1) == -1
            RS_ROOM:LOCAL:R방주인:0 = LOCAL:1
            PRINTFORML {LOCAL}번 방에 %CALLNAME:(LOCAL:1)% 배정
            LOCAL++
        ENDIF
    NEXT
ENDIF