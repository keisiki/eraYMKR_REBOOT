@RBT_ITEMVIEW()
#DIM CONST 개행횟수 = 4
VARSET LOCAL
PRINTFORML 현재의 아이템 목록
DRAWLINE
FOR LOCAL,0,100
    CALL RBT_ITEMVIEW_EACH(LOCAL)
    LOCAL:1 += RESULT
    IF LOCAL:1 >= 개행횟수
        LOCAL:1 = 0
        PRINTL
    ENDIF
NEXT
SIF LOCAL:1 > 0
    PRINTL  │
DRAWLINE
WAIT

@RBT_ITEMVIEW_EACH(NUM)
#DIM DYNAMIC NUM
IF INRANGE(NUM,0,1000)
    SIF ITEM:NUM <= 0
        RETURN 0
    PRINTFORM  │ [{NUM,3,RIGHT}] - %ITEMNAME:NUM,15,LEFT% 
    IF ITEM:NUM > 1
        PRINTFORM  * {ITEM:NUM,4,LEFT}
    ELSE
        PRINTFORM %" " * 7%
    ENDIF
    RETURN 1
ENDIF
RETURN 0