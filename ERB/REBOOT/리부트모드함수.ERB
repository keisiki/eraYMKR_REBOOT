@RBT_SHOW_MULTIPLIER(ARG)
PRINTFORML □ 수치 증감변화
SIF 호감도증가배율(ARG)
    PRINTBUTTONC @"호감도증가:{100 + 호감도증가배율(ARG)}％",69740001
SIF 순종증가배율(ARG)
    PRINTBUTTONC @"순종증가:{100 + 순종증가배율(ARG)}％",69740002
SIF 굴복증가배율(ARG)
    PRINTBUTTONC @"굴복증가:{100 + 굴복증가배율(ARG)}％",69740003
SIF 부정증가배율(ARG)
    PRINTBUTTONC @"부정증가배율:{100 + 부정증가배율(ARG)}％",69740004
SIF 회복배율(ARG)
    PRINTBUTTONC @"회복배율:{100 + 회복배율(ARG)}％",69740005
SIF 타겟대우(ARG)
    PRINTBUTTONC @"만족도:{타겟대우(ARG)}",69740006
PRINTL
CUSTOMDRAWLINE ･

@RBT_PATCHER()
IF !GETBIT(FLAG:리부트패치,1)
    SETBIT FLAG:리부트패치,1
    VARSET RS_청소, -1
    CALL RBT_RS_GAMEINIT(CALC_SLAVE_CAPACITY())
    FOR LOCAL:1, 0, CHARANUM
        IF RBT_RS_CHARA_TO_ROOMNUM(LOCAL:1) == -1
            RS_ROOM:LOCAL:R방주인:0 = LOCAL:1
            PRINTFORML {LOCAL}번 방에 %CALLNAME:(LOCAL:1)% 배정
            CALL RBT_RS_CLEANINIG_SLAVE_CHANGE(LOCAL,LOCAL:1)
            LOCAL++
        ENDIF
    NEXT
    ITEM:연료 = 50
    희망온도 = 20
ENDIF