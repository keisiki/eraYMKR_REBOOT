@CLRMSG(ARGS)
#DIM DYNAMIC CODEMODE
#DIMS DYNAMIC STRING,2
#DIM DYNAMIC POINTER
#DIMS DYNAMIC CODE,2
STRING:0 '= ARGS
WHILE 1
    IF CODEMODE
        POINTER = STRFIND(STRING:0, ">")
        CODE:0 '= SUBSTRING(STRING:0,1,POINTER -1 )
        STRING:1 '= SUBSTRING(STRING:0,POINTER + 1,-1)
        STRING:0 '= STRING:1
        STRING:1 '= ""
        SPLIT CODE:0, " ", CODE
        SELECTCASE CODE:0
            CASE "SETCOLOR"
                SETCOLOR TOINT(CODE:1)
            CASE "RESETCOLOR"
                RESETCOLOR
            CASE "\n"
                PRINTL
        ENDSELECT
        CODEMODE = 0
    ELSE
        POINTER = STRFIND(STRING:0, "<")
        IF POINTER != -1
            STRING:1 '= SUBSTRING(STRING:0,POINTER,-1)
            STRING:0 '= SUBSTRING(STRING:0,0,POINTER)
            CODEMODE = 1
        ENDIF
        PRINTFORM %STRING:0%
        SIF POINTER == -1
            BREAK
        STRING:0 '= STRING:1
        STRING:1 '= ""
    ENDIF
    SIF STRLENS(STRING:0) <= 0
        BREAK
WEND

@BASE_PERCENT(ARG,ARGS)
#FUNCTION
RETURNF BASE:ARG:ARGS * 100 / MAXBASE:ARG:ARGS

@RBT_SWITCH(조건,조건2,ARG:0,ARGS:0,ARG:1 = 0,ARGS:1 = "",ARG:2 = 0,ARGS:2 = "",ARG:3 = 0,ARGS:3 = "",ARG:4 = 0,ARGS:4 = "",ARG:5 = 0,ARGS:5 = "")
#FUNCTIONS
#DIM DYNAMIC 조건
#DIMS DYNAMIC 조건2
#DIM CONST MAX_ARG = 6
FOR LOCAL,0,MAX_ARG
    SELECTCASE 조건2
        CASE "이하"
            SIF 조건 <= ARG:LOCAL
                RETURNF ARGS:LOCAL
        CASE "이상"
            SIF 조건 >= ARG:LOCAL
                RETURNF ARGS:LOCAL
        CASE "미만"
            SIF 조건 < ARG:LOCAL
                RETURNF ARGS:LOCAL
        CASE "초과"
            SIF 조건 > ARG:LOCAL
                RETURNF ARGS:LOCAL
        CASE "일치"
            SIF 조건 == ARG:LOCAL
                RETURNF ARGS:LOCAL
    ENDSELECT
    
NEXT


