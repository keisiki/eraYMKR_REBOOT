#DIM DYNAMIC 크기,5
#DIM DYNAMIC 업그레이드비용
#DIM DYNAMIC 만족도배수
#DIMS DYNAMIC 가구명
#DIMS DYNAMIC 수식어,5
#DIMS DYNAMIC 한줄평
;정의부, 이곳만 수정하면 된다
ID = R침대
가구명 '= "침대"
크기:0 = 0
크기:1 = 0
크기:2 = 1
크기:3 = 2
크기:4 = 99999
업그레이드비용 = 10000
만족도배수 = 50
수식어:0 '= ""
수식어:1 '= "낡은 "
수식어:2 '= "평범한 "
수식어:3 '= "고급스런 "
수식어:4 '= ""
한줄평 '= "한 명이 눕기 적당한 침대다, 노예의 생활과 조교의 대다수가 이 위에서 이루어진다"

;이하는 건들필요 없음
SELECTCASE ARGS
    CASE "존재"
        RETURN ID
    CASE "강화"
        RETURN RS_ROOM:방번호:ID:0
    CASE "상태"
        RETURN RS_ROOM:방번호:ID:1
    CASE "강화비용"
        RETURN 업그레이드비용
    CASE "현재크기"
        RETURN 크기:(RS_ROOM:방번호:ID:0)
    CASE "다음크기"
        RETURN 크기:(RS_ROOM:방번호:ID:0 + 1) - 크기:(RS_ROOM:방번호:ID:0)
    CASE "만족도배수"
        RETURN 만족도배수 * RS_ROOM:방번호:ID:0
    CASE "가구명"
        RESULTS '= 수식어:(RS_ROOM:방번호:ID:0) + 가구명
        RETURN
    CASE "한줄평"
        RESULTS '= 한줄평
        RETURN
ENDSELECT


