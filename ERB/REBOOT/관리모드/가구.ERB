;--------------------------------------------------------------------------------------------
;RBT_RS_FUNIture
;--------------------------------------------------------------------------------------------
;--------------------------------------------------------------------------------------------
;가구 업그레이드 정합성 판정
;--------------------------------------------------------------------------------------------
@RBT_RS_FUNI_CAN_UPGRADE(방번호, ID)
#DIM DYNAMIC 방번호
#DIM DYNAMIC ID
TRYCALLFORM RBT_RS_FUNI_{ID}(방번호,"다음크기")
LOCAL = RESULT
CALL RBT_RS_NOW_FUNITURE(방번호)
IF RESULT + LOCAL > RBT_RS_MAX_FUNITURE(방번호)
    RETURN 1
ENDIF

TRYCALLFORM RBT_RS_FUNI_{ID}(방번호,"강화비용")
IF RESULT > MONEY
    RETURN 2
ENDIF

RETURN 0

;--------------------------------------------------------------------------------------------
;가구 업그레이드 처리
;--------------------------------------------------------------------------------------------
@RBT_RS_FUNI_UPGRADE(방번호, ID, ARG = 0)
#DIM DYNAMIC 방번호
#DIM DYNAMIC ID
IF !ARG
    TRYCALLFORM RBT_RS_FUNI_{ID}(방번호,"강화비용")
    MONEY -= RESULT
ENDIF
RS_ROOM:방번호:ID:0 ++
RS_ROOM:방번호:ID:1 = 100 ;내구도를 초기화
CALL RBT_RS_FUNI_APPLICATION(RBT_RS_ROOMNUM_TO_CHARA(방번호))
CALL RBT_RS_FUNI_APPLICATION_ROOM(방번호)

;--------------------------------------------------------------------------------------------
;가구 내구도 자연감소
;--------------------------------------------------------------------------------------------
@RBT_RS_FUNI_WORN(방번호)
#DIM DYNAMIC 방번호
FOR LOCAL,R_MIN가구,R_MAX가구
    TRYCALLFORM RBT_RS_FUNI_{LOCAL}(방번호,"존재")
    IF RESULT == LOCAL
        CALLFORM RBT_RS_FUNI_{LOCAL}(방번호,"강화")
        IF RESULT && RAND:2
            CALL RBT_RS_DAMAGE(방번호,LOCAL,1)
        ENDIF
    ENDIF
NEXT

;--------------------------------------------------------------------------------------------
;가구 적용
;--------------------------------------------------------------------------------------------
@RBT_RS_FUNI_APPLICATION(ARG)
IF ARG == -1
    RETURN
ENDIF
IF RBT_RS_CHARA_TO_ROOMNUM() == -1
    ;노숙자다
    회복배율:ARG:0 = -50
ELSE
    회복배율:ARG:0 = 0
    SELECTCASE RBT_RS_FUNI_UPGREADED(RBT_RS_CHARA_TO_ROOMNUM(ARG),R침대)
        CASE 0
            회복배율:ARG:0 -= 5
            순종증가배율:ARG:0 -= 5
        CASE 1
            회복배율:ARG:0 += 0
        CASE 2
            회복배율:ARG:0 += 2
            호감도증가배율:ARG:0 += 1
        CASEELSE
            회복배율:ARG:0 += 5
            순종증가배율:ARG:0 += 5
            호감도증가배율:ARG:0 += 5
    ENDSELECT

    SELECTCASE RBT_RS_FUNI_UPGREADED(RBT_RS_CHARA_TO_ROOMNUM(ARG),R침구)
        CASE 0
            회복배율:ARG:0 -= 5
            순종증가배율:ARG:0 -= 5
        CASE 1
            회복배율:ARG:0 += 0
        CASE 2
            회복배율:ARG:0 += 2
            호감도증가배율:ARG:0 += 1
        CASEELSE
            회복배율:ARG:0 += 5
            순종증가배율:ARG:0 += 5
            호감도증가배율:ARG:0 += 5
    ENDSELECT

    SELECTCASE RBT_RS_FUNI_UPGREADED(RBT_RS_CHARA_TO_ROOMNUM(ARG),R탁자)
        CASE 1
            회복배율:ARG:0 += 1
        CASE 2
            회복배율:ARG:0 += 3
            호감도증가배율:ARG:0 += 1
        CASE 3
            회복배율:ARG:0 += 5
            순종증가배율:ARG:0 += 5
            호감도증가배율:ARG:0 += 5
    ENDSELECT

    SELECTCASE RBT_RS_FUNI_UPGREADED(RBT_RS_CHARA_TO_ROOMNUM(ARG),R난로)
        CASE 1
            회복배율:ARG:0 += 1
        CASE 2
            회복배율:ARG:0 += 1
            호감도증가배율:ARG:0 += 1
        CASE 3
            회복배율:ARG:0 += 1
            순종증가배율:ARG:0 += 1
            호감도증가배율:ARG:0 += 2
    ENDSELECT

    SELECTCASE RBT_RS_FUNI_UPGREADED(RBT_RS_CHARA_TO_ROOMNUM(ARG),R창문)
        CASE 1
            순종증가배율:ARG:0 += 1
            부정증가배율:ARG:0 -= 1
        CASE 2
            순종증가배율:ARG:0 += 2
            부정증가배율:ARG:0 -= 2
        CASE 3
            순종증가배율:ARG:0 += 3
            호감도증가배율:ARG:0 += 1
            부정증가배율:ARG:0 -= 3
    ENDSELECT
ENDIF

@RBT_RS_FUNI_APPLICATION_ROOM(ARG)
보온정도:ARG:0 = 0
냉방정도:ARG:0 = 0
IF RBT_CS_AVER_TEMP(DAY:5) <= 10
    SELECTCASE RBT_RS_FUNI_UPGREADED(ARG,R창문)
        CASE 1
            보온정도:ARG:0 += 0
        CASE 2
            보온정도:ARG:0 += 5
        CASE 3
            보온정도:ARG:0 += 10
    ENDSELECT
    SELECTCASE RBT_RS_FUNI_UPGREADED(ARG,R침구)
        CASE 0
        CASE 1
            보온정도:ARG:0 += 5
        CASE 2
            보온정도:ARG:0 += 8
        CASEELSE
            보온정도:ARG:0 += 10
    ENDSELECT
ELSEIF RBT_CS_AVER_TEMP(DAY:5) >= 24
    SELECTCASE RBT_RS_FUNI_UPGREADED(ARG,R창문)
        CASE 0
        CASEELSE
            냉방정도:ARG:0 += 1
    ENDSELECT
    SELECTCASE RBT_RS_FUNI_UPGREADED(ARG,R선풍기)
        CASE 0
        CASE 1
            냉방정도:ARG:0 += 2
        CASE 2
            냉방정도:ARG:0 += 3
        CASEELSE
            냉방정도:ARG:0 += 5
    ENDSELECT
ENDIF

;--------------------------------------------------------------------------------------------
;가구 상황 파악용 함수들
;--------------------------------------------------------------------------------------------
@RBT_RS_FUNI_UPGREADED(방번호,ID)
#FUNCTION
#DIM DYNAMIC 방번호
#DIM DYNAMIC ID
RETURNF RS_ROOM:방번호:ID:0

@RBT_RS_FUNI_DURABLITY(방번호,ID)
#FUNCTION
#DIM DYNAMIC 방번호
#DIM DYNAMIC ID
RETURNF RS_ROOM:방번호:ID:1

