;정의부, 이곳만 수정하면 된다
ID = R선풍기
가구명 '= "선풍기"
크기:0 = 0
크기:1 = 0
크기:2 = 0
크기:3 = 0
크기:4 = 99999
업그레이드비용 = 10000
만족도배수 = 75
수식어:0 '= ""
수식어:1 '= "고물 "
수식어:2 '= ""
수식어:3 '= "최신 "
수식어:4 '= ""
SELECTCASE RS_ROOM:방번호:ID:0
    CASE 1
        한줄평 '= "싸구려 선풍기, 바람도 약하고 시끄럽다"
    CASE 2
        한줄평 '= "그럭저럭 쓸 만한 선풍기, 여름 더위를 쓸어내준다"
    CASE 3
        한줄평 '= "팬이 없지만 엄청나게 시원한 선풍기"
ENDSELECT

;이하는 건들필요 없음
SELECTCASE ARGS
    CASE "존재"
        RETURN ID
    CASE "강화"
        RETURN RS_ROOM:방번호:ID:0
    CASE "상태"
        RETURN RS_ROOM:방번호:ID:1
    CASE "강화비용"
        RETURN 업그레이드비용
    CASE "현재크기"
        RETURN 크기:(RS_ROOM:방번호:ID:0)
    CASE "다음크기"
        RETURN 크기:(RS_ROOM:방번호:ID:0 + 1) - 크기:(RS_ROOM:방번호:ID:0)
    CASE "만족도배수"
        RETURN 만족도배수 * RS_ROOM:방번호:ID:0
    CASE "가구명"
        RESULTS '= 수식어:(RS_ROOM:방번호:ID:0) + 가구명
        RETURN
    CASE "한줄평"
        RESULTS '= 한줄평
        RETURN
ENDSELECT