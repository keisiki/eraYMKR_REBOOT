;--------------------------------------------------------------------------------------------
;RBT_RS_FUNIture
;--------------------------------------------------------------------------------------------
;--------------------------------------------------------------------------------------------
;가구 업그레이드 정합성 판정
;--------------------------------------------------------------------------------------------
@RBT_RS_FUNI_CAN_UPGRADE(방번호, ID)
#DIM DYNAMIC 방번호
#DIM DYNAMIC ID
TRYCALLFORM RBT_RS_FUNI_{ID}(방번호,"다음크기")
LOCAL = RESULT
CALL RBT_RS_NOW_FUNITURE(방번호)
IF RESULT + LOCAL > RBT_RS_MAX_FUNITURE(방번호)
    RETURN 1
ENDIF

TRYCALLFORM RBT_RS_FUNI_{ID}(방번호,"강화비용")
IF RESULT > MONEY
    RETURN 2
ENDIF

RETURN 0

;--------------------------------------------------------------------------------------------
;가구 업그레이드 처리
;--------------------------------------------------------------------------------------------
@RBT_RS_FUNI_UPGRADE(방번호, ID, ARG = 0)
#DIM DYNAMIC 방번호
#DIM DYNAMIC ID
IF !ARG
    TRYCALLFORM RBT_RS_FUNI_{ID}(방번호,"강화비용")
    MONEY -= RESULT
ENDIF
RS_ROOM:방번호:ID:0 ++
RS_ROOM:방번호:ID:1 = 100 ;내구도를 초기화
CALL RBT_RS_FUNI_APPLICATION(RBT_RS_ROOMNUM_TO_CHARA(방번호))
CALL RBT_RS_FUNI_APPLICATION_ROOM(방번호)

;--------------------------------------------------------------------------------------------
;가구 내구도 자연감소
;--------------------------------------------------------------------------------------------
@RBT_RS_FUNI_WORN(방번호)
#DIM DYNAMIC 방번호
FOR LOCAL,R_MIN가구,R_MAX가구
    TRYCALLFORM RBT_RS_FUNI_{LOCAL}(방번호,"존재")
    IF RESULT == LOCAL
        CALLFORM RBT_RS_FUNI_{LOCAL}(방번호,"강화")
        IF RESULT && RAND:2
            CALL RBT_RS_DAMAGE(방번호,LOCAL,1)
        ENDIF
    ENDIF
NEXT

;--------------------------------------------------------------------------------------------
;가구 적용
;--------------------------------------------------------------------------------------------
@RBT_RS_FUNI_APPLICATION(캐릭터)
#DIM DYNAMIC 방번호
#DIM DYNAMIC 캐릭터
IF 캐릭터 == -1
    RETURN
ENDIF
방번호 = RBT_RS_CHARA_TO_ROOMNUM(캐릭터)
IF 방번호 == -1
    ;노숙자다
    회복배율:캐릭터:0 = -50
ELSE
    호감도증가배율:캐릭터:0 = 0
    순종증가배율:캐릭터:0 = 0
    굴복증가배율:캐릭터:0 = 0
    부정증가배율:캐릭터:0 = 0
    회복배율:캐릭터:0 = 0
    FOR LOCAL,R_MIN가구,R_MAX가구
        TRYCALLFORM RBT_RS_FUNI_{LOCAL}(방번호,"존재")
        SIF RESULT != LOCAL
            CONTINUE
        CALLFORM RBT_RS_FUNI_{LOCAL}(방번호,"호감도증가배율")
        호감도증가배율:캐릭터:0 += RESULT
        CALLFORM RBT_RS_FUNI_{LOCAL}(방번호,"순종증가배율")
        순종증가배율:캐릭터:0 += RESULT
        CALLFORM RBT_RS_FUNI_{LOCAL}(방번호,"굴복증가배율")
        굴복증가배율:캐릭터:0 += RESULT
        CALLFORM RBT_RS_FUNI_{LOCAL}(방번호,"부정증가배율")
        부정증가배율:캐릭터:0 += RESULT
        CALLFORM RBT_RS_FUNI_{LOCAL}(방번호,"회복배율")
        회복배율:캐릭터:0 += RESULT
    NEXT
ENDIF

@RBT_RS_FUNI_APPLICATION_ROOM(방번호)
#DIM DYNAMIC 방번호
보온정도:방번호:0 = 0
냉방정도:방번호:0 = 0
IF RBT_CS_AVER_TEMP(DAY:5) <= 10
    FOR LOCAL,R_MIN가구,R_MAX가구
        TRYCALLFORM RBT_RS_FUNI_{LOCAL}(방번호,"존재")
        SIF RESULT != LOCAL
            CONTINUE
        CALLFORM RBT_RS_FUNI_{LOCAL}(방번호,"보온정도")
        보온정도:방번호:0 += RESULT
    NEXT
ELSEIF RBT_CS_AVER_TEMP(DAY:5) >= 24
    FOR LOCAL,R_MIN가구,R_MAX가구
        TRYCALLFORM RBT_RS_FUNI_{LOCAL}(방번호,"존재")
        SIF RESULT != LOCAL
            CONTINUE
        CALLFORM RBT_RS_FUNI_{LOCAL}(방번호,"냉방정도")
        냉방정도:방번호:0 += RESULT
    NEXT
ENDIF

