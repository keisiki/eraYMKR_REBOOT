;--------------------------------------------------------------------------------------------
;ReBooT RoomSystem
;--------------------------------------------------------------------------------------------

;--------------------------------------------------------------------------------------------
;게임 초기 주어지는 방을 설정
;버려진 저택 설정에 맞게 다소 낡게 설정
;--------------------------------------------------------------------------------------------
@RBT_RS_GAMEINIT(ARG = 11)
FOR LOCAL,0,1000
    RS_ROOM:LOCAL:R방주인:0 = -1
NEXT
FOR LOCAL,0,ARG
    CALL RBT_RS_INIT(LOCAL)
    CALL RBT_RS_POLLUTE(LOCAL,300)
    CALL RBT_RS_FUNI_UPGRADE(LOCAL, R침대, 1) ;초기 방의 기본 침대/침구 세트는 지급
    CALL RBT_RS_FUNI_UPGRADE(LOCAL, R침구, 1)
    CALL RBT_RS_FUNI_UPGRADE(LOCAL, R난로, 1)
    CALL RBT_RS_DAMAGE(LOCAL, R침대, 50)
    CALL RBT_RS_DAMAGE(LOCAL, R침구, 50)
    CALL RBT_RS_DAMAGE(LOCAL, R난로, 80)
    LOCAL:1 ++
NEXT
;RS_ROOM:0:R방주인:0 = 0
RETURN LOCAL:1

;--------------------------------------------------------------------------------------------
;방을 새로 만들때 초기 값을 기입
;--------------------------------------------------------------------------------------------
@RBT_RS_INIT(방번호)
#DIM DYNAMIC 방번호
CALL RBT_RS_MAKEHOMELESS(방번호)
RS_ROOM:방번호:R방크기:0 = 1

;--------------------------------------------------------------------------------------------
;방을 비움
;--------------------------------------------------------------------------------------------
@RBT_RS_MAKEHOMELESS(방번호)
#DIM DYNAMIC 방번호
RS_ROOM:방번호:R방주인:0 = -1

;--------------------------------------------------------------------------------------------
;방 이름 반환 함수
;--------------------------------------------------------------------------------------------
@RBT_RS_ROOMNAME(방번호)
#FUNCTIONS
#DIM DYNAMIC 방번호
IF RS_ROOM:방번호:R방주인:0 != -1
    LOCALS '= @"%CALLNAME:(RS_ROOM:방번호:R방주인:0)%의 방"
ELSE
    LOCALS '= @"{방번호}번 방"
ENDIF
RETURNF LOCALS

;--------------------------------------------------------------------------------------------
;방의 더러움 증가 함수, 음수 입력으로 청소 가능
;함수화 하는 이유는 정합성 판정 때문
;--------------------------------------------------------------------------------------------
@RBT_RS_POLLUTE(방번호, 강도)
#DIM DYNAMIC 방번호
#DIM DYNAMIC 강도
RS_ROOM:방번호:R위생도:0 = LIMIT(RS_ROOM:방번호:R위생도:0 + 강도, 0, R_최대오염도)

;--------------------------------------------------------------------------------------------
;방 확장에 대한 정합성 및 비용 책정
;--------------------------------------------------------------------------------------------
@RBT_RS_ROOM_EXPANSIONABLE(방번호)
#DIM DYNAMIC 방번호
#DIM DYNAMIC 비용
IF RS_ROOM:방번호:R방크기:0 + 1 >= R_최대방크기
    RETURN -1
ENDIF
비용 = RS_ROOM:방번호:R방크기:0 * 10000
RETURN 비용

;--------------------------------------------------------------------------------------------
;가구를 들여놓을 수 있는 양을 반환
;--------------------------------------------------------------------------------------------
@RBT_RS_MAX_FUNITURE(방번호)
#FUNCTION
#DIM DYNAMIC 방번호
; 1을 빼는 이유 = 조교 대상이 있을 공간 1이 필요하다
RETURNF RS_ROOM:방번호:R방크기:0 - 1

;--------------------------------------------------------------------------------------------
;가구를 들여놓은 양을 반환
;--------------------------------------------------------------------------------------------
@RBT_RS_NOW_FUNITURE(방번호)
#DIM DYNAMIC 방번호
VARSET LOCAL
FOR LOCAL,R_MIN가구,R_MAX가구
    TRYCALLFORM RBT_RS_FUNI_{LOCAL}(방번호,"존재")
    IF RESULT == LOCAL
        TRYCALLFORM RBT_RS_FUNI_{LOCAL}(방번호,"현재크기")
        LOCAL:1 += RESULT
    ENDIF
    RESULT = 0
NEXT
RETURN LOCAL:1 

;--------------------------------------------------------------------------------------------
;가구에 데미지 부여
;--------------------------------------------------------------------------------------------
@RBT_RS_DAMAGE(방번호,ARG, ARG:1)
#DIM DYNAMIC 방번호
TRYCALLFORM RBT_RS_FUNI_{ARG}(방번호,"존재")
SIF RESULT != ARG
    RETURN 0
RS_ROOM:방번호:ARG:1 -= ARG:1
IF RS_ROOM:방번호:ARG:1 < 0
    CALL RBT_RS_BROKEN(방번호,ARG)
ENDIF

;--------------------------------------------------------------------------------------------
;가구 파괴
;--------------------------------------------------------------------------------------------
@RBT_RS_BROKEN(방번호,ARG)
#DIM DYNAMIC 방번호
TRYCALLFORM RBT_RS_FUNI_{ARG}(방번호,"존재")
SIF RESULT != ARG
    RETURN 0
RS_ROOM:방번호:ARG:0 = 0 
RS_ROOM:방번호:ARG:1 = 0
TRYCALLFORM RBT_RS_FUNI_{ARG}(방번호,"가구명")
PRINTFORMW %RBT_RS_ROOMNAME(방번호)%의 %조사처리(RESULTS,"가")% 완전히 망가져 못쓰게 되어버렸습니다.

;--------------------------------------------------------------------------------------------
;가구 수리
;--------------------------------------------------------------------------------------------
@RBT_RS_REPAIR(방번호,ARG)
#DIM DYNAMIC 방번호
#DIM DYNAMIC 수리비
#DIM DYNAMIC 내구도
TRYCALLFORM RBT_RS_FUNI_{ARG}(방번호,"존재")
SIF RESULT != ARG
    RETURN 0
TRYCALLFORM RBT_RS_FUNI_{ARG}(방번호,"가구명")
LOCALS '= RESULTS
DRAWLINE
PRINTFORML %LOCALS%의 수리를 진행합니까?
DRAWLINE
CALLFORM RBT_RS_FUNI_{ARG}(방번호,"상태")
내구도 = RESULT
CALLFORM RBT_RS_FUNI_{ARG}(방번호,"강화비용")
수리비 = ((100 - 내구도) * RESULT) / 100
PRINTFORML 내구도: [{내구도}/100] ---> [100/100]
PRINTFORMLC 소지금: {MONEY}\\
PRINTFORMLC 비용 : {수리비}\\
PRINTL
PRINTFORML 수리 후 남을 자금: {MONEY - 수리비}\\
DRAWLINE
IF MONEY < 수리비
    PRINTFORML 비용이 부족합니다
    RETURN
ENDIF
PRINTFORML [0] 예
PRINTFORML [1] 아니오
INPUT
IF RESULT == 0
    MONEY -= 수리비
    RS_ROOM:방번호:ARG:1 = 100
ENDIF

;--------------------------------------------------------------------------------------------
;가구 업그레이드 창
;--------------------------------------------------------------------------------------------
@RBT_RS_UPGRADE_VIEW(방번호,ARG)
#DIM DYNAMIC 방번호
#DIM DYNAMIC 강화비

TRYCALLFORM RBT_RS_FUNI_{ARG}(방번호,"존재")
SIF RESULT != ARG
    RETURN 0
TRYCALLFORM RBT_RS_FUNI_{ARG}(방번호,"가구명")
LOCALS '= RESULTS
PRINTFORML %LOCALS%의 업그레이드를 진행합니까?
DRAWLINE
PRINTFORMLC 소지금: {MONEY}\\
CALLFORM RBT_RS_FUNI_{ARG}(방번호,"강화비용")
강화비 = RESULT
PRINTFORMLC 비용 : {강화비}\\
PRINTL
PRINTFORML 수리 후 남을 자금: {MONEY - 강화비}\\
CALLFORM RBT_RS_FUNI_{ARG}(방번호,"현재크기")
LOCAL = RESULT
CALLFORM RBT_RS_FUNI_{ARG}(방번호,"다음크기")
LOCAL:1 = LOCAL + RESULT
PRINTFORML 크기: {LOCAL} -> {LOCAL:1} 
DRAWLINE
CALL RBT_RS_FUNI_CAN_UPGRADE(방번호,ARG)
SELECTCASE RESULT
    CASE 1
        PRINTFORMW 방에 여유 공간이 부족하여 업그레이드 할 수 없습니다
        RETURN
    CASE 2
        PRINTFORMW 자금이 부족해 업그레이드 할 수 없습니다
        RETURN
    CASEELSE
ENDSELECT
PRINTFORML [0] 예
PRINTFORML [1] 아니오
INPUT
IF RESULT == 0
    CALL RBT_RS_FUNI_UPGRADE(방번호, ARG)
ENDIF

;--------------------------------------------------------------------------------------------
;방 크기 확장
;--------------------------------------------------------------------------------------------
@RBT_RS_ROOM_EXTAND(방번호)
#DIM DYNAMIC 방번호
#DIM DYNAMIC 공사비
DRAWLINE
CALL RBT_RS_ROOM_EXPANSIONABLE(방번호)
IF RESULT == -1
    PRINTFORML 더 이상 %RBT_RS_ROOMNAME(방번호)%의 확장을 진행할 수 없습니다
    RETURN
ENDIF
공사비 = RESULT
PRINTFORML %RBT_RS_ROOMNAME(방번호)%에 대한 확장을 진행하시겠습니까?
PRINTFORMLC 소지금: {MONEY}\\
PRINTFORMLC 공사비: {공사비}\\
PRINTL
PRINTFORML 공사 후 남을 자금: {MONEY - 공사비}\\
DRAWLINE
IF MONEY < 공사비
    PRINTFORML 비용이 부족합니다
    RETURN
ENDIF
PRINTFORML [0] 예
PRINTFORML [1] 아니오
INPUT
IF RESULT == 0
    MONEY -= 공사비
    RS_ROOM:방번호:R방크기:0 += 1
    PRINTFORMW %RBT_RS_ROOMNAME(방번호)%의 넓이가 {RS_ROOM:방번호:R방크기:0}가 되었습니다
ENDIF

;--------------------------------------------------------------------------------------------
;방 상태 확인
;--------------------------------------------------------------------------------------------
@RBT_RS_VIEW(방번호)
#DIM DYNAMIC 방번호
#DIM DYNAMIC TEMPLINE
#DIMS DYNAMIC 묘사,12
#DIM DYNAMIC SELECTED
;총 라인 수는 32줄 정도
TEMPLINE = LINECOUNT
DRAWLINE
PRINTFORML {방번호}번 방
PRINTFORMLC 거주자: \@RS_ROOM:방번호:R방주인:0 != -1 ? %NAME:(RS_ROOM:방번호:R방주인:0)% # 비어있음\@
SELECTCASE (1000 - RS_ROOM:방번호:R위생도:0) / 10
    CASE IS > 80
        SETCOLOR 0X00FFFF
    CASE IS > 50
        RESETCOLOR
    CASE IS > 30
        SETCOLOR 0XFAFA00
    CASEELSE
        SETCOLOR 0XFF4040
ENDSELECT
PRINTFORMLC 청결도: {(1000 - RS_ROOM:방번호:R위생도:0) / 10,3}％　　　　　
PRINTBUTTONLC @"체감 온도:{CS_기온}+{보온정도(방번호)+냉방정도(방번호)} = {CS_기온+보온정도(방번호)+냉방정도(방번호)}℃",9999
PRINT 청소담당자:
PRINTBUTTON RBT_RS_CLEANINIG_SLAVE(방번호) == -1 ? "없음" # NAME:(RBT_RS_CLEANINIG_SLAVE(방번호)),6974
RESETCOLOR
PRINTL
DRAWLINE
;방 크기 묘사
PRINTFORML %조사처리(RBT_RS_ROOMNAME(방번호),"는")%…
SELECTCASE RBT_RS_MAX_FUNITURE(방번호)
    CASE 0
        PRINTFORML 사람 두 명 간신히 누울 수준이다…
    CASE 1
        PRINTFORML 평범한 크기다.
    CASE 2
        PRINTFORML 상당히 넓다…
    CASE IS > 3
        PRINTFORML 태평양만큼 넓다…
ENDSELECT
PRINTL
;가구 묘사
PRINTFORML %RBT_RS_ROOMNAME(방번호)%에는…
FOR LOCAL, R_MIN가구, R_MAX가구
    VARSET RESULTS
    TRYCALLFORM RBT_RS_FUNI_{LOCAL}(방번호,"강화")
    IF RESULT > 0
        TRYCALLFORM RBT_RS_FUNI_{LOCAL}(방번호,"상태")
        SELECTCASE RESULT
            CASE IS < 25
                PRINT 망가진 
            CASE IS < 50
                PRINT 거의 망가진 
            CASE IS < 75
                PRINT 살짝 망가진 
            CASEELSE
        ENDSELECT
        TRYCALLFORM RBT_RS_FUNI_{LOCAL}(방번호,"가구명")
        PRINTFORML %조사처리(RESULTS,"가")% 있다.
    ENDIF
NEXT
DRAWLINE
CALL RBT_RS_NOW_FUNITURE(방번호)
PRINTFORML 방 크기: [{RESULT}/{RBT_RS_MAX_FUNITURE(방번호)+1}]
FOR LOCAL, R_MIN가구, R_MAX가구
    VARSET RESULTS
    TRYCALLFORM RBT_RS_FUNI_{LOCAL}(방번호,"강화")
    IF RESULT > 0
        IF LOCAL == SELECTED
            SETCOLOR 0X00FFFF
        ENDIF
        TRYCALLFORM RBT_RS_FUNI_{LOCAL}(방번호,"가구명")
        PRINTBUTTON @"[%RESULTS%] ", LOCAL
        RESETCOLOR
    ENDIF
NEXT
PRINTL
DRAWLINE
FOR LOCAL,0,11
    PRINTFORML %묘사:LOCAL%
NEXT
FOR LOCAL,0,31 - (LINECOUNT - TEMPLINE)
    PRINTFORML
NEXT
DRAWLINE
PRINTFORMLC \@방번호 <= 0 ? %" " * 13% # [800] 이전 방\@
PRINTFORMLC  
PRINTFORMLC  
PRINTFORMLC  
PRINTFORMLC \@방번호 >= CALC_SLAVE_CAPACITY() - 1 ? %" " * 13% # [801] 다음 방\@
PRINTL
PRINTFORMLC [994] 방 주인 변경
PRINTFORMLC [995] 업그레이드
PRINTFORMLC [996] 수리
PRINTFORMLC [997] 새 가구 도입
PRINTFORMLC [998] 확장
PRINTL
PRINTFORML [999] 돌아간다
INPUT
SELECTCASE RESULT
    CASE 999
        RETURN
    CASE 800
        방번호 = MAX(0,방번호 - 1)
        SELECTED = 0
        VARSET 묘사
    CASE 801
        방번호 = MIN(CALC_SLAVE_CAPACITY(),방번호 + 1)
        SELECTED = 0
        VARSET 묘사
    CASE 994
        CALL RBT_RS_CHANGE_CHARA(방번호)
    CASE 995
        IF !SELECTED
            PRINTFORMW 먼저 가구를 선택해 주십시오
        ENDIF
        CALL RBT_RS_UPGRADE_VIEW(방번호,SELECTED)
        GOTO 묘사리프레시
    CASE 996
        IF !SELECTED
            PRINTFORMW 먼저 가구를 선택해 주십시오
        ENDIF
        CALL RBT_RS_REPAIR(방번호,SELECTED)
        GOTO 묘사리프레시
    CASE 997
        CALL RBT_RS_FUNI_SHOP(방번호)
    CASE 998
        CALL RBT_RS_ROOM_EXTAND(방번호)
    CASE 6974
        CALL RBT_RS_CLEANINIG_SLAVE_CHANGE_UI(방번호)
    CASE 9999
        CALL RBT_RS_HEATING_REASON_UI(방번호)
    CASEELSE
        IF SELECTED == RESULT
            SELECTED = 0
            VARSET 묘사
            RESTART
        ENDIF
        SELECTED = RESULT
        $묘사리프레시
        VARSET 묘사
        TRYCCALLFORM RBT_RS_FUNI_{SELECTED}(방번호,"강화")
        CATCH
            RESTART
        ENDCATCH
        CALLFORM RBT_RS_FUNI_{SELECTED}(방번호,"가구명")
        묘사:0 '= "[" + RESULTS + "]"
        CALLFORM RBT_RS_FUNI_{SELECTED}(방번호,"상태")
        묘사:1 '= "내구도: [" + @"{RESULT}" + "／100]"
        CALLFORM RBT_RS_FUNI_{SELECTED}(방번호,"강화")
        묘사:2 '= "강화: " + @"{RESULT}" + "단계"
        CALLFORM RBT_RS_FUNI_{SELECTED}(방번호,"현재크기")
        묘사:3 '= "크기: " + @"{RESULT}"
        묘사:4 '= ""
        CALLFORM RBT_RS_FUNI_{SELECTED}(방번호,"한줄평")
        묘사:5 '= @"%RESULTS%"
        LOCAL = 5
        WHILE 1
            STRFIND 묘사:LOCAL, "\br"
            IF RESULT == -1
                BREAK
            ELSE
                묘사:(LOCAL + 1) '= SUBSTRING(묘사:LOCAL,RESULT + 2, -1)
                묘사:LOCAL '= SUBSTRING(묘사:LOCAL,0,RESULT)
                LOCAL++
            ENDIF
        WEND
ENDSELECT
RESTART
;--------------------------------------------------------------------------------------------
;방 리스트 확인
;--------------------------------------------------------------------------------------------
@RBT_RS_ROOMLIST
#DIM DYNAMIC 방번호

DRAWLINE
PRINTFORM 확인하고 싶은 방을 선택해주세요 <page.{LOCAL:1 + 1}>　　　
PRINTBUTTON "[공용시설]",100000
PRINTL
DRAWLINE
FOR LOCAL, 0, 20
    방번호 = LOCAL + (LOCAL:1 * 20)
    SIF !RS_ROOM:방번호:R방크기:0
        CONTINUE
    PRINTFORM [{방번호,4,RIGHT}] %RBT_RS_ROOMNAME(방번호),20,LEFT% 
    CALL RBT_RS_CLEANESS_COLOR
    PRINTFORM 청결도:{(1000 - RS_ROOM:방번호:R위생도:0)/10,3,RIGHT}％
    RESETCOLOR
    PRINTL
NEXT
DRAWLINE
PRINTFORMLC \@LOCAL:1 <= 0 ?   # [9000] 이전페이지로\@
PRINTFORMLC   
PRINTFORMLC \@CALC_SLAVE_CAPACITY() / 20 >= LOCAL:1 + 1 ? [9900] 다음페이지로 # \@
PRINTL
PRINTFORML [9999] 돌아간다
INPUT
IF RESULT == 9999
    RETURN
ELSEIF RESULT == 9000 && LOCAL:1 > 0
    LOCAL:1--
ELSEIF RESULT == 9900 && CALC_SLAVE_CAPACITY() / 20 >= LOCAL:1 + 1
    LOCAL:1++
ELSEIF RESULT == 100000
    CALL RBT_RS_COMMUNAL_ROOM
ELSEIF RESULT >= 0 && RESULT <= 1000 && RESULT <= CALC_SLAVE_CAPACITY() - 1
    CALL RBT_RS_VIEW(RESULT)
ELSE
    RESTART
ENDIF
RESTART
;--------------------------------------------------------------------------------------------
;캐릭터번호로 부터 묵는 방 번호를 반환
;--------------------------------------------------------------------------------------------
@RBT_RS_CHARA_TO_ROOMNUM(ARG)
#FUNCTION
#DIM DYNAMIC 방번호
FOR 방번호,0,1000
    IF RS_ROOM:방번호:R방주인:0 == ARG
        RETURNF 방번호
    ENDIF
NEXT
RETURNF -1

;--------------------------------------------------------------------------------------------
;위의 역함수
;--------------------------------------------------------------------------------------------
@RBT_RS_ROOMNUM_TO_CHARA(방번호)
#FUNCTION
#DIM DYNAMIC 방번호
IF RS_ROOM:방번호:R방주인:0 != -1
    RETURNF RS_ROOM:방번호:R방주인:0
ENDIF
RETURNF -1


;--------------------------------------------------------------------------------------------
;청결도에 따른 글자색 변경
;--------------------------------------------------------------------------------------------
@RBT_RS_CLEANESS_COLOR(ARG)
SELECTCASE (1000 - RS_ROOM:ARG:R위생도:0) / 10
    CASE IS > 80
        SETCOLOR 0X00FFFF
    CASE IS > 50
        RESETCOLOR
    CASE IS > 30
        SETCOLOR 0XFAFA00
    CASEELSE
        SETCOLOR 0XFF4040
ENDSELECT

;--------------------------------------------------------------------------------------------
;새 가구 도입
;--------------------------------------------------------------------------------------------
@RBT_RS_FUNI_SHOP(방번호)
#DIM DYNAMIC 방번호
#DIMS DYNAMIC 가구명
#DIM DYNAMIC 가격
#DIM DYNAMIC 필요공간
DRAWLINE
PRINTFORML 무엇을 사겠습니까? (소지금 {MONEY} 원)
DRAWLINE
FOR LOCAL,R_MIN가구,R_MAX가구
    TRYCALLFORM RBT_RS_FUNI_{LOCAL}(방번호,"존재")
    IF RESULT == LOCAL
        CALLFORM RBT_RS_FUNI_{LOCAL}(방번호,"강화")
        IF RESULT != 0
            CONTINUE
        ELSE
            CALLFORM RBT_RS_FUNI_{LOCAL}(방번호,"가구명")
            가구명 '= RESULTS
            CALLFORM RBT_RS_FUNI_{LOCAL}(방번호,"강화비용")
            가격 = RESULT
            CALLFORM RBT_RS_FUNI_{LOCAL}(방번호,"다음크기")
            PRINTFORML [{LOCAL}] %가구명,10,LEFT%({가격}원)(크기:{RESULT})
        ENDIF
    ENDIF
NEXT
DRAWLINE
PRINTFORML [100] 돌아가기
INPUT
IF RESULT == 100
    RETURN
ELSE
    LOCAL = RESULT
    CALLFORM RBT_RS_FUNI_{LOCAL}(방번호,"가구명")
    가구명 '= RESULTS
    CALLFORM RBT_RS_FUNI_{LOCAL}(방번호,"강화비용")
    가격 = RESULT
    CALLFORM RBT_RS_FUNI_{LOCAL}(방번호,"다음크기")
    필요공간 = RESULT
    CALL RBT_RS_NOW_FUNITURE(방번호)
    IF 필요공간 > RBT_RS_MAX_FUNITURE(방번호) - RESULT
        PRINTFORMW 여유공간이 부족합니다
        RESTART
    ENDIF
    IF MONEY >= 가격
        PRINTFORMW <%조사처리(가구명,"를")% 구입했습니다.>
        MONEY -= 가격
        CALL RBT_RS_FUNI_UPGRADE(방번호,LOCAL)
    ELSE
        PRINTFORMW 돈이 부족합니다
    ENDIF
ENDIF
RESTART


;--------------------------------------------------------------------------------------------
;거주자 변경
;--------------------------------------------------------------------------------------------
@RBT_RS_CHANGE_CHARA(방번호)
#DIM DYNAMIC 방번호
DRAWLINE
PRINTFORML 현재 방 주인: %RS_ROOM:방번호:R방주인:0 == -1 ? "비어있음" # CALLNAME:(RS_ROOM:방번호:R방주인:0) %
DRAWLINE
IF RS_ROOM:방번호:R방주인:0 == -1
    SETCOLOR 0X555555
ENDIF
PRINTFORML [0] 비운다
RESETCOLOR
PRINTFORML [1] 입주시킨다
PRINTFORML [999] 돌아가기
INPUT
IF RESULT == 999
    RETURN
ELSEIF RESULT == 0
    CALL RBT_RS_MAKEHOMELESS(방번호)
ELSE
    $LOOP1
    DRAWLINE
    PRINTFORML 누구를 입주시킵니까?
    DRAWLINE
    FOR LOCAL,LOCAL:1 * 20,MIN(CHARANUM,LOCAL:1 * 20 + 20)
        PRINTFORML [{LOCAL + LOCAL:1 * 20}] %CALLNAME:LOCAL,20,LEFT% 현재거주지:%RBT_RS_CHARA_TO_ROOMNUM(LOCAL) == -1 ? "복도" # RBT_RS_ROOMNAME(RBT_RS_CHARA_TO_ROOMNUM(LOCAL))%
    NEXT
    DRAWLINE
    PRINTFORMLC \@LOCAL:1 <= 0 ?   # [900] 이전페이지\@
    PRINTFORMLC \@LOCAL:1 * 20 > CHARANUM ?   # [990] 다음페이지\@
    PRINTFORML [999] 돌아가기
    INPUT
    IF RESULT == 999
    ELSEIF LOCAL:1 > 0 && RESULT == 900
        LOCAL:1--
    ELSEIF LOCAL:1 * 20 <= CHARANUM && RESULT == 990
        LOCAL:1++
    ELSEIF INRANGE(RESULT,0,CHARANUM)
        LOCAL:2 = RESULT
        IF RBT_RS_CHARA_TO_ROOMNUM(LOCAL:2) != -1
            CALL RBT_RS_MAKEHOMELESS(RBT_RS_CHARA_TO_ROOMNUM(LOCAL:2))
        ENDIF
        RS_ROOM:방번호:R방주인:0 = LOCAL:2
    ELSE
        GOTO LOOP1
    ENDIF
ENDIF
RESTART


;--------------------------------------------------------------------------------------------
;청소 실행
;--------------------------------------------------------------------------------------------
@RBT_RS_CLEANINIG(방번호,ARG)
#DIM DYNAMIC 방번호
#DIM DYNAMIC 청소력
SIF 방번호 == -1
    RETURN
청소력 = ABL:ARG:기교 * 5
;더러울수록 청소력이 높아진다
SELECTCASE (1000 - RS_ROOM:방번호:R위생도:0)/10
    CASE IS < 30
        TIMES 청소력, 1.5
    CASE IS < 50
        TIMES 청소력, 1.3
    CASE IS < 80
        TIMES 청소력, 1.0
    CASEELSE
        TIMES 청소력, 0.8
ENDSELECT
SIF TALENT:ARG:냄새민감
    청소력 += 10
SIF TALENT:ARG:냄새둔감
    청소력 -= 5
SIF TALENT:ARG:불결무시
    청소력 -= 10
SELECTCASE BASE:ARG:체력 + BASE:ARG:기력
    CASE IS < 500
        TIMES 청소력, 0.1
    CASE IS < 1000
        TIMES 청소력, 0.8
    CASE IS < 1500
        TIMES 청소력, 1.0
    CASEELSE
        TIMES 청소력, 1.1
ENDSELECT
;50~150% 편차 도입
청소력 = 청소력 / 2 + RAND:(MAX(1,청소력))
RS_ROOM:방번호:R위생도:0 = LIMIT(RS_ROOM:방번호:R위생도:0 - 청소력, 0, R_최대오염도)

;--------------------------------------------------------------------------------------------
;방번호로부터 청소 담당자를 파악
;--------------------------------------------------------------------------------------------
@RBT_RS_CLEANINIG_SLAVE(방번호)
#FUNCTION
#DIM DYNAMIC 방번호
FOR LOCAL,0,CHARANUM
    SIF RS_청소:LOCAL:0 == 방번호
        RETURNF LOCAL
NEXT
RETURNF -1

