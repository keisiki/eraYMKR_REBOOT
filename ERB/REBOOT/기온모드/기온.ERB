;ReBooT ClimateSystem
@RBT_CS_SET_TEMP()
#DIM DYNAMIC 현재달
#DIM DYNAMIC 최종기온
현재달 = DAY:5

최종기온 = CS_기온 + (RAND:5 - 2)
최종기온 = LIMIT(최종기온, 최저기온:현재달 - 2, 최고기온:현재달 + 2)
;이상기후를 넣고 싶다면 이쪽에, 이 위는 월별 최저 최고 기온에 의한 리미트가 걸려버린다, 초기화는 어차피 다음날 되면 풀리니 오히려 지속할 방법을 찾는게 유리

;

CS_기온 = 최종기온

@RBT_CS_SET_COLOR_BY_TEMP(ARG)
SELECTCASE ARG
    CASE IS >= 25
        SETCOLOR 0XFF0000
    CASE IS >= 20
        SETCOLOR 0XAA1111
    CASE IS >= 15

    CASE IS >= 10
    CASE IS >= 5
        SETCOLOR 0X228899
    CASE IS >= 0
        SETCOLOR 0X2255AA
    CASE IS >= -5
        SETCOLOR 0X2211AA
    CASEELSE
        SETCOLOR 0X2211FF
ENDSELECT